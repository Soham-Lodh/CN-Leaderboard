# ------------------------------------------------------------------
# Coding Ninjas KIIT Chapter Leaderboard — environment example
# Copy to .env (local) or configure in your host's secret manager.
# NEVER put real values in this file; it is committed to source control.
# -------------------------------------------------------------------

# --- Supabase (Project Settings -> API) ---------------------------
# Project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe for the browser bundle by design
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- PostgreSQL connection strings --------------------------------
# Runtime connection: use the SUPABASE POOLER URL (port 6543) in
# serverless/pooled environments, with pgbouncer=true prepended as
# Supabase documents it. Example:
# DATABASE_URL="postgresql://postgres.REF:PASS@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL=
# Direct connection (port 5432) used ONLY by the Prisma CLI for
# migrations and tooling. Example:
# DIRECT_URL="postgresql://postgres:PASS@db.REF.supabase.com:5432/postgres"
DIRECT_URL=

# --- Site URL ------------------------------------------------------
# Absolute base URL of the deployment; used for canonical URLs and the
# Supabase OAuth redirect. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# --- Institutional email policy ------------------------------------
# Emails must be verified and end in exactly "@" + this domain
# (case-insensitive). Default: kiit.ac.in
ALLOWED_EMAIL_DOMAIN=kiit.ac.in

# --- One-time first-President bootstrap ----------------------------
# The first active President. Provisioned idempotently on the first request.
BOOTSTRAP_PRESIDENT_EMAIL=
# Optional second factor for the bootstrap operator; if set, the CLI
# requires matching --secret. Rotate/delete after first successful run.
BOOTSTRAP_SECRET=

# --- Tuning (sensible defaults; optional) ---------------------------
LOCK_TIMEOUT_MS=2000
STATEMENT_TIMEOUT_MS=8000
